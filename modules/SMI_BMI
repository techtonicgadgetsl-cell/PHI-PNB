        function calculateAgeInMonths(dobStr) {
            if(!dobStr) return null;
            let dob = new Date(dobStr);
            if (isNaN(dob.getTime())) return null;
            const today = new Date();

            // Registers often use a 2-digit year (e.g. "17.12.31"). If the model
            // assumed 20XX and that lands in the future, it really meant 19XX.
            if (dob.getTime() > today.getTime()) {
                dob = new Date(dob.getFullYear() - 100, dob.getMonth(), dob.getDate());
            }

            let months = (today.getFullYear() - dob.getFullYear()) * 12;
            months -= dob.getMonth();
            months += today.getMonth();
            // A month only "completes" once we reach the same day-of-month as the
            // birth date. Without this check, e.g. DOB 2015-09-10 evaluated on
            // 2026-09-03 was counted as a full extra month even though the
            // student's birthday hasn't happened yet this month.
            if (today.getDate() < dob.getDate()) months -= 1;
            return months <= 0 ? 0 : months;
        }

        function findClosestAgeData(refObj, ageMonths) {
            if (!refObj || ageMonths === null) return null;
            if (refObj[ageMonths]) return refObj[ageMonths];
            const availableAges = Object.keys(refObj).map(Number);
            if (availableAges.length === 0) return null;
            let closest = null, minDiff = Infinity;
            availableAges.forEach(a => {
                const diff = Math.abs(a - ageMonths);
                if (diff < minDiff) { minDiff = diff; closest = a; }
            });
            return (closest !== null && minDiff <= 2) ? refObj[closest] : null;
        }

        function classifyBMI(bmi, arr) {
            if (!arr) return { label: 'Pending', cls: 'badge-pending' };
            if (bmi < arr[0]) return { label: 'Severe Wasting', cls: 'badge-severe' };
            if (bmi < arr[1]) return { label: 'Wasting', cls: 'badge-danger' };
            if (bmi <= arr[4]) return { label: 'Normal', cls: 'badge-normal' };
            if (bmi <= arr[5]) return { label: 'Overweight', cls: 'badge-warning' };
            return { label: 'Obesity', cls: 'badge-severe' };
        }

        function classifyHFA(height, arr) {
            if (!arr) return { label: 'Pending', cls: 'badge-pending' };
            if (height < arr[0]) return { label: 'Severe Stunt (<-3SD)', cls: 'badge-severe' };
            if (height < arr[1]) return { label: 'Stunting (<-2SD)', cls: 'badge-danger' };
            return { label: 'Normal', cls: 'badge-normal' };
        }

        // A row where serial_no, name, dob, height AND weight are ALL blank means
        // nothing was written for that student that day -> treat as Absent.
        function isAbsentRecord(item) {
            const blank = v => v === null || v === undefined || String(v).trim() === '';
            return blank(item.serial_no) && blank(item.name) && blank(item.dob)
                && blank(item.height_cm) && blank(item.weight_kg);
        }

        // Safety net: serial_no is a printed sequential number, so if the model dropped
        // a genuinely blank row instead of outputting it, there will be a gap in the
        // sequence (e.g. 1,2,4,5 - missing 3). Detect gaps and re-insert a blank/absent
        // placeholder at the right position, so a later child's real data can never end
        // up shifted into an earlier, absent child's row.
        function fillMissingSerialRows(data) {
            const bySerial = {};
            let maxSerial = 0;
            let numericCount = 0;
            data.forEach(d => {
                const n = parseInt(String(d.serial_no).trim(), 10);
                if (!isNaN(n) && String(n) === String(d.serial_no).trim()) {
                    bySerial[n] = d;
                    numericCount++;
                    if (n > maxSerial) maxSerial = n;
                }
            });
            // Only safe to do this if most rows actually have clean numeric serials
            if (numericCount < data.length * 0.5 || maxSerial === 0 || maxSerial > data.length * 3) {
                return data;
            }
            const filled = [];
            for (let i = 1; i <= maxSerial; i++) {
                filled.push(bySerial[i] || { serial_no: String(i), name: '', dob: '', height_cm: null, weight_kg: null });
            }
            // Preserve any rows with non-numeric or out-of-sequence serials at the end
            data.forEach(d => {
                const n = parseInt(String(d.serial_no).trim(), 10);
                if (isNaN(n) || n < 1 || n > maxSerial) filled.push(d);
            });
            return filled;
        }

        // --- Progress bar helpers (shows a live % + stage label while Gemini scans) ---
        let progressInterval = null;
        let currentProgressPct = 0;

        function setProgress(pct, label) {
            currentProgressPct = Math.min(100, Math.max(0, pct));
            const bar = document.getElementById('progress-bar');
            const pctEl = document.getElementById('progress-pct');
            const stageEl = document.getElementById('progress-stage');
            if (bar) bar.style.width = currentProgressPct + '%';
            if (pctEl) pctEl.textContent = Math.round(currentProgressPct) + '%';
            if (stageEl && label) stageEl.textContent = label;
        }

        // Eases the bar toward capPct without ever quite reaching it - since we can't
        // know exactly how long the Gemini call will take, this gives an honest sense
        // of "still working" rather than a fake linear fill.
        function startProgressCreep(capPct, label) {
            stopProgressCreep();
            setProgress(currentProgressPct, label);
            progressInterval = setInterval(() => {
                currentProgressPct += (capPct - currentProgressPct) * 0.08;
                setProgress(currentProgressPct, label);
            }, 200);
        }
        function stopProgressCreep() {
            if (progressInterval) { clearInterval(progressInterval); progressInterval = null; }
        }

        async function processImageWithGemini() {
            const apiKey = document.getElementById('api-key').value.trim();
            if (!apiKey) { alert("Please enter API Key!"); return; }
            if (!compressedBase64) { alert("Please select/scan an image or PDF first."); return; }

            const loading = document.getElementById('loading');
            const analyzeBtn = document.getElementById('analyze-btn');
            loading.classList.remove('hidden');
            analyzeBtn.disabled = true;
            setProgress(4, 'Preparing image...');

            const dateFormat = document.getElementById('date-format').value;
            const heightUnit = document.getElementById('height-unit').value;
            const weightUnit = document.getElementById('weight-unit').value;

            // Build a live example (e.g. "17/06/2005") from the token order + separator in dateFormat,
            // using a sample date so the model sees exactly which digit-group means what.
            const sample = { YYYY: '2005', YY: '05', MM: '06', DD: '17' };
            const exampleStr = dateFormat.replace(/YYYY|YY|MM|DD/g, m => sample[m]);
            const tokens = dateFormat.split(/[^A-Z]+/).filter(Boolean); // e.g. ['DD','MM','YYYY']
            const tokenNames = { YYYY: '4-digit year', YY: '2-digit year', MM: 'month', DD: 'day' };
            const orderDesc = tokens.map(t => tokenNames[t]).join(', then ');
            const is2DigitYear = tokens.includes('YY');

            const dateInstruction = `Date of birth is handwritten in ${dateFormat} order (${orderDesc}) - for example "${exampleStr}" means 17 June 2005. The exact punctuation between the numbers in the handwriting may differ slightly (".", "-", "/", or a space) - only the ORDER of day/month/year matters, read whatever separator is actually written. Convert every date to ISO "YYYY-MM-DD" for output.${is2DigitYear ? ` For the 2-digit year, if 20YY would place the birth date in the future relative to today (${new Date().toISOString().slice(0,10)}), use 19YY instead.` : ''}`;

            const heightInstruction = heightUnit === 'ft'
                ? `Height is recorded in feet (decimal, e.g. 3.94) - convert it to centimeters for "height_cm" (feet * 30.48).`
                : `Height is recorded in centimeters - output "height_cm" as-is.`;
            const weightInstruction = weightUnit === 'g'
                ? `Weight is recorded in grams - convert it to kilograms for "weight_kg" (grams / 1000).`
                : `Weight is recorded in kilograms - output "weight_kg" as-is.`;

            const prompt = `Extract every row from this sheet into a valid JSON array only, one object per printed row (top to bottom, in order).\n\nKeys required for every row: "serial_no" (String), "name" (String), "dob" (String in YYYY-MM-DD format), "height_cm" (Number), "weight_kg" (Number).\n\nPriority: "serial_no" and "dob" must both be read with maximum accuracy - double-check every digit against the handwriting before finalizing. A wrong "dob" throws off the calculated age and pushes the student's data point off the growth chart entirely, so treat each digit of the date as carefully as the serial number. Work column by column for the date-of-birth field: look at ALL the dates in that column together first to learn this writer's personal shapes for each digit (0-9), then read each individual date using that reference - this resolves most ambiguous digits (e.g. 1 vs 7, 0 vs 6, 3 vs 8, 5 vs 6) far more reliably than reading each date in isolation. If a specific digit is still genuinely illegible after this cross-check, leave that row's "dob" as an empty string rather than guessing - a blank is safer than a wrong date. For "name", a quick best-effort reading is fine, do not over-analyze handwriting style.\n\n${dateInstruction}\n\n${heightInstruction}\n${weightInstruction}\n\nDo NOT skip or merge blank rows. This is critical: the number of objects in your output array MUST exactly equal the number of printed/ruled rows in the register, in the same top-to-bottom order - even if some rows have no handwriting at all. If a row's serial number is printed but nothing else is written, still output an object for it with empty string / null values. Never let one row's data shift into another row's position - each object must correspond to exactly one physical row on the paper. Do not add markdown, explanations, or extra keys. If a value cannot be read, use an empty string for serial_no/name/dob and null for height_cm/weight_kg.`;

            // Updated to send dynamic MIME type (image or application/pdf)
            const requestBody = {
                contents: [{
                    parts: [
                        { text: prompt },
                        { inlineData: { mimeType: imageMimeType, data: compressedBase64 } }
                    ]
                }],
                generationConfig: {
                    responseMimeType: "application/json",
                    // Extraction is a simple, structured task - turning off/limiting the
                    // model's "thinking" step removes the biggest source of delay.
                    thinkingConfig: { thinkingLevel: analysisMode === 'fast' ? "minimal" : "low" },
                    maxOutputTokens: 4096
                }
            };

            // Fastest/lightest models first (they're plenty accurate for structured
            // data extraction), heavier models only as a fallback if those fail.
            // Fast mode: lightest/quickest model first. Accurate mode: most capable model first.
            const models = analysisMode === 'fast'
                ? ["gemini-3.5-flash-lite", "gemini-3.6-flash", "gemini-3.7-flash"]
                : ["gemini-3.7-flash", "gemini-3.6-flash", "gemini-3.5-flash-lite"];
            let lastError = null;
            const REQUEST_TIMEOUT_MS = 20000; // don't let a single attempt hang forever
            const stageCaps = [58, 76, 90]; // progress cap while trying each fallback model

            try {
                for (let mIdx = 0; mIdx < models.length; mIdx++) {
                    const model = models[mIdx];
                    startProgressCreep(stageCaps[mIdx] ?? 90, `Scanning with Gemini AI (${mIdx + 1}/${models.length})...`);
                    for (let attempt = 0; attempt < 3; attempt++) {
                        try {
                            const controller = new AbortController();
                            const timeoutId = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
                            let response;
                            try {
                                response = await fetch(
                                    `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(apiKey)}`,
                                    { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(requestBody), signal: controller.signal }
                                );
                            } finally {
                                clearTimeout(timeoutId);
                            }

                            if (!response.ok) {
                                let detail = '';
                                try { detail = (await response.json())?.error?.message || ''; } catch (_) {}
                                const retryable = [429, 500, 502, 503, 504].includes(response.status);
                                if (retryable && attempt < 2) {
                                    await new Promise(resolve => setTimeout(resolve, 1000 * Math.pow(2, attempt)));
                                    continue;
                                }
                                throw new Error(`HTTP ${response.status}${detail ? ': ' + detail : ''}`);
                            }

                            const data = await response.json();
                            const responseText = data?.candidates?.[0]?.content?.parts?.map(part => part?.text || '').join('').replace(/```json/gi, '').replace(/```/g, '').trim();

                            if (!responseText) throw new Error('Gemini returned an empty response.');
                            
                            let parsed;
                            try { parsed = JSON.parse(responseText); } catch (e) { throw new Error('Invalid JSON returned.'); }
                            if (!Array.isArray(parsed)) throw new Error('Unexpected data format returned.');

                            stopProgressCreep();
                            setProgress(92, 'Parsing extracted data...');
                            extractedGlobalData = fillMissingSerialRows(parsed);
                            setProgress(96, 'Building table & charts...');
                            populateTableAndDropdown();
                            updateCharts();
                            document.getElementById('analytics-section').classList.remove('hidden');
                            document.getElementById('analytics-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
                            setProgress(100, 'Done ✓');
                            await new Promise(r => setTimeout(r, 450));
                            return;
                        } catch (error) {
                            lastError = error?.name === 'AbortError' ? new Error('Request timed out, retrying...') : error;
                            if (/HTTP (429|500|502|503|504)|Failed to fetch|NetworkError|timed out/i.test(String(lastError?.message || '')) && attempt < 2) {
                                await new Promise(resolve => setTimeout(resolve, 1000 * Math.pow(2, attempt)));
                                continue;
                            }
                            break;
                        }
                    }
                }
                alert('Error:\n' + (lastError?.message || 'Unknown Gemini API error.'));
            } finally {
                stopProgressCreep();
                loading.classList.add('hidden');
                analyzeBtn.disabled = false;
                setProgress(0, 'Preparing...');
            }
        }

        // Lets the user manually correct a mis-read Height/Weight value straight in the
