                    <td class="px-2 py-2 text-center">
                        <input type="number" step="0.1" inputmode="decimal" value="${item.weight_kg ?? ''}" placeholder="-"
                            onchange="editRecordField(${index}, 'weight_kg', this.value)"
                            class="w-16 text-center bg-transparent border-b border-dashed border-emerald-500/40 focus:border-emerald-400 focus:bg-emerald-500/10 outline-none rounded px-1 py-1 mono" title="Click to correct this value">
                    </td>
                    <td class="px-4 py-3 text-center font-extrabold text-slate-800">${bmi}</td>
                    <td class="px-4 py-3 text-center"><span class="badge ${hfaStatus.cls}">${hfaStatus.label}</span></td>
                    <td class="px-4 py-3 text-center"><span class="badge ${bmiStatus.cls}">${bmiStatus.label}</span></td>
                    <td class="px-4 py-3 text-center text-xs font-semibold text-slate-600 border-l border-slate-200 bg-blue-50/30 whitespace-nowrap">${targetHeightTxt}</td>
                    <td class="px-4 py-3 text-center text-xs font-semibold text-slate-600 bg-blue-50/30 whitespace-nowrap">${targetWeightTxt}</td>
                    <td class="px-4 py-3 text-center bg-blue-50/30">${actionTxt}</td>
                `;
                tbody.appendChild(tr);
            });
            document.getElementById('record-count').innerText = absentCount > 0
                ? `${extractedGlobalData.length} (${absentCount} absent)`
                : extractedGlobalData.length;
        }

        function updateCharts() {
            const gender = document.getElementById('gender').value;
            const filterValue = document.getElementById('student-filter').value;
            
            if(bmiChartInstance) bmiChartInstance.destroy();
            if(hfaChartInstance) hfaChartInstance.destroy();

            const bmiWHOData = typeof whoData !== 'undefined' ? whoData.bmi[gender] : null;
            const hfaWHOData = typeof whoData !== 'undefined' ? whoData.hfa[gender] : null;
            if(!bmiWHOData || !hfaWHOData) return;

            const ageKeys = Object.keys(bmiWHOData).sort((a,b) => a-b);
            const bmiLines = { sd3: [], sd2: [], sd1: [], sd0: [], sd1neg: [], sd2neg: [], sd3neg: [] };
            const hfaLines = { sd3: [], sd2: [], sd1: [], sd0: [], sd1neg: [], sd2neg: [], sd3neg: [] };

            ageKeys.forEach(ageKey => {
                const age = Number(ageKey);
                if(bmiWHOData[age]) {
                    bmiLines.sd3neg.push({x: age, y: bmiWHOData[age][0]});
                    bmiLines.sd2neg.push({x: age, y: bmiWHOData[age][1]});
                    bmiLines.sd1neg.push({x: age, y: bmiWHOData[age][2]});
                    bmiLines.sd0.push({x: age, y: bmiWHOData[age][3]});
                    bmiLines.sd1.push({x: age, y: bmiWHOData[age][4]});
                    bmiLines.sd2.push({x: age, y: bmiWHOData[age][5]});
                    bmiLines.sd3.push({x: age, y: bmiWHOData[age][6]});
                }
                if(hfaWHOData[age]) {
                    hfaLines.sd3neg.push({x: age, y: hfaWHOData[age][0]});
                    hfaLines.sd2neg.push({x: age, y: hfaWHOData[age][1]});
                    hfaLines.sd1neg.push({x: age, y: hfaWHOData[age][2]});
                    hfaLines.sd0.push({x: age, y: hfaWHOData[age][3]});
                    hfaLines.sd1.push({x: age, y: hfaWHOData[age][4]});
                    hfaLines.sd2.push({x: age, y: hfaWHOData[age][5]});
                    hfaLines.sd3.push({x: age, y: hfaWHOData[age][6]});
                }
            });

            const minRefAge = Number(ageKeys[0]);
            const maxRefAge = Number(ageKeys[ageKeys.length - 1]);

            let studentBmiPoints = [], studentHfaPoints = [], outOfRangeCount = 0;
            extractedGlobalData.forEach((item, index) => {
                if(filterValue !== 'ALL' && index.toString() !== filterValue) return;
                const ageMonths = calculateAgeInMonths(item.dob);
                if(ageMonths !== null && item.weight_kg && item.height_cm) {
                    if (ageMonths < minRefAge || ageMonths > maxRefAge) { outOfRangeCount++; return; }
                    const heightM = item.height_cm / 100;
                    studentBmiPoints.push({ x: ageMonths, y: parseFloat((item.weight_kg / (heightM * heightM)).toFixed(2)), name: item.name });
                    studentHfaPoints.push({ x: ageMonths, y: parseFloat(item.height_cm), name: item.name });
                }
            });
            const outOfRangeNote = document.getElementById('chart-outlier-note');
            if (outOfRangeNote) {
                outOfRangeNote.classList.toggle('hidden', outOfRangeCount === 0);
                outOfRangeNote.textContent = outOfRangeCount > 0
                    ? `⚠ ${outOfRangeCount} student(s) hidden from the charts - their DOB gives an age outside the WHO reference range. Correct the DOB in the "විශ්ලේෂිත දත්ත" table below.`
                    : '';
            }

            const pointSize = filterValue === 'ALL' ? (window.innerWidth < 768 ? 4 : 5) : 10;

            const baseOptions = {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'nearest', intersect: false },
                scales: { 
                    x: { 
                        type: 'linear', 
                        min: minRefAge,
                        max: maxRefAge,
                        title: { display: true, text: 'Age (Months)' },
                        ticks: { callback: function(value) { return Math.floor(value/12) + '.' + (value%12) + 'y'; } }
                    }, 
                    y: { title: { display: true } } 
                },
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 6, font: { size: 10 } } },
                    tooltip: { callbacks: { label: function(ctx) {
                        if(ctx.dataset.type === 'scatter') {
                            const years = Math.floor(ctx.raw.x / 12);
                            const mos = ctx.raw.x % 12;
                            return `${ctx.raw.name} - Age: ${years}.${mos}y, Val: ${ctx.raw.y}`;
                        }
                        return `${ctx.dataset.label}: ${ctx.raw.y}`;
                    }}}
                }
            };

            const bmiCtx = document.getElementById('whoBmiChart').getContext('2d');
            let bmiOpts = JSON.parse(JSON.stringify(baseOptions));
            bmiOpts.scales.y.title.text = 'BMI (kg/m²)';
            
            bmiChartInstance = new Chart(bmiCtx, {
                data: {
                    datasets: [
                        { type: 'line', label: '+3 SD (Obesity)', data: bmiLines.sd3, borderColor: '#ef4444', borderWidth: 1, pointRadius: 0, fill: 1, backgroundColor: 'rgba(239, 68, 68, 0.2)' },
                        { type: 'line', label: '+2 SD (Overweight)', data: bmiLines.sd2, borderColor: '#f97316', borderWidth: 1, pointRadius: 0, fill: 2, backgroundColor: 'rgba(249, 115, 22, 0.2)' },
                        { type: 'line', label: '+1 SD (Normal)', data: bmiLines.sd1, borderColor: '#22c55e', borderWidth: 1, pointRadius: 0, fill: 4, backgroundColor: 'rgba(34, 197, 94, 0.2)' },
                        { type: 'line', label: 'Median', data: bmiLines.sd0, borderColor: '#166534', borderWidth: 2, borderDash: [5,5], pointRadius: 0, fill: false }, 
                        { type: 'line', label: '-2 SD (Wasting)', data: bmiLines.sd2neg, borderColor: '#f97316', borderWidth: 1, pointRadius: 0, fill: 5, backgroundColor: 'rgba(249, 115, 22, 0.2)' },
                        { type: 'line', label: '-3 SD (Severe Wasting)', data: bmiLines.sd3neg, borderColor: '#ef4444', borderWidth: 1, pointRadius: 0, fill: 'origin', backgroundColor: 'rgba(239, 68, 68, 0.2)' },
                        { type: 'scatter', label: 'Students', data: studentBmiPoints, backgroundColor: '#2563eb', borderColor: '#1e3a8a', pointRadius: pointSize, pointHoverRadius: pointSize + 3 }
                    ]
                },
                options: bmiOpts
            });

            const hfaCtx = document.getElementById('whoHfaChart').getContext('2d');
            let hfaOpts = JSON.parse(JSON.stringify(baseOptions));
            hfaOpts.scales.y.title.text = 'Height (cm)';
            
            hfaChartInstance = new Chart(hfaCtx, {
                data: {
                    datasets: [
                        { type: 'line', label: '+3 SD', data: hfaLines.sd3, borderColor: '#3b82f6', borderWidth: 1, pointRadius: 0, fill: 1, backgroundColor: 'rgba(59, 130, 246, 0.1)' },
                        { type: 'line', label: '+2 SD', data: hfaLines.sd2, borderColor: '#22c55e', borderWidth: 1, pointRadius: 0, fill: 4, backgroundColor: 'rgba(34, 197, 94, 0.15)' },
                        { type: 'line', label: '+1 SD', data: hfaLines.sd1, borderColor: '#22c55e', borderWidth: 0, pointRadius: 0, fill: false, hidden: true },
                        { type: 'line', label: 'Median', data: hfaLines.sd0, borderColor: '#166534', borderWidth: 2, borderDash: [5,5], pointRadius: 0, fill: false }, 
                        { type: 'line', label: '-2 SD (Stunting <-2SD)', data: hfaLines.sd2neg, borderColor: '#f97316', borderWidth: 1, pointRadius: 0, fill: 5, backgroundColor: 'rgba(249, 115, 22, 0.2)' },
                        { type: 'line', label: '-3 SD (Severe Stunt <-3SD)', data: hfaLines.sd3neg, borderColor: '#ef4444', borderWidth: 1, pointRadius: 0, fill: 'origin', backgroundColor: 'rgba(239, 68, 68, 0.2)' },
                        { type: 'scatter', label: 'Students', data: studentHfaPoints, backgroundColor: '#8b5cf6', borderColor: '#4c1d95', pointRadius: pointSize, pointHoverRadius: pointSize + 3 }
                    ]
                },
                options: hfaOpts
            });
        }
    </script>
</body>
</html>
