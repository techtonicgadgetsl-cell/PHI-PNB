<!DOCTYPE html>
<html lang="si">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#020806">
    <title>SMI Pro - Fullscreen WHO Charts</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap');
        :root {
            --primary: #22d3ee;
            --primary-dark: #06b6d4;
            --accent: #39ff88;
            --surface: rgba(6,14,12,.88);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background:
                radial-gradient(circle at 8% 0%, rgba(34,211,238,.10), transparent 34%),
                radial-gradient(circle at 92% 8%, rgba(57,255,136,.08), transparent 32%),
                repeating-linear-gradient(0deg, rgba(57,255,136,.025) 0px, rgba(57,255,136,.025) 1px, transparent 1px, transparent 26px),
                repeating-linear-gradient(90deg, rgba(57,255,136,.025) 0px, rgba(57,255,136,.025) 1px, transparent 1px, transparent 26px),
                linear-gradient(180deg, #030807 0%, #020504 100%);
            min-height: 100dvh;
            -webkit-tap-highlight-color: transparent;
            color: #d1fae5;
        }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #020504; }
        ::-webkit-scrollbar-thumb { background: rgba(57,255,136,.35); border-radius: 4px; }
        button, input, select { -webkit-appearance: none; }
        button { touch-action: manipulation; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .app-card {
            background: var(--surface);
            border: 1px solid rgba(57,255,136,.22);
            box-shadow: 0 0 0 1px rgba(34,211,238,.04), 0 12px 35px rgba(0,0,0,.55), 0 0 24px rgba(57,255,136,.05);
            backdrop-filter: blur(14px);
        }
        .app-card:hover { box-shadow: 0 0 0 1px rgba(34,211,238,.08), 0 16px 42px rgba(0,0,0,.6), 0 0 28px rgba(57,255,136,.1); }
        .primary-btn {
            background: linear-gradient(135deg, #06b6d4 0%, #22d3ee 45%, #39ff88 100%);
            box-shadow: 0 0 18px rgba(57,255,136,.35), 0 10px 24px rgba(6,182,212,.25);
            color: #021a10 !important;
            letter-spacing: .02em;
        }
        .primary-btn:active { transform: translateY(1px) scale(.995); }
        .scan-box {
            background: linear-gradient(135deg, rgba(6,20,17,.9), rgba(4,14,20,.9));
            border-color: rgba(34,211,238,.4);
        }
        .loader { border-top-color: #39ff88; -webkit-animation: spinner 1s linear infinite; animation: spinner 1s linear infinite; }
        @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .badge { padding: 0.35rem 0.6rem; border-radius: 0.5rem; font-size: 0.75rem; font-weight: 700; display: inline-block; white-space: nowrap; border: 1px solid transparent;}
        .badge-normal { background-color: rgba(57,255,136,.12); color: #6ef5a5; border-color: rgba(57,255,136,.35); }
        .badge-warning { background-color: rgba(250,204,21,.12); color: #fde68a; border-color: rgba(250,204,21,.35); }
        .badge-danger { background-color: rgba(248,113,113,.12); color: #fca5a5; border-color: rgba(248,113,113,.35); }
        .badge-severe { background-color: #dc2626; color: #fff1f1; box-shadow: 0 0 10px rgba(220,38,38,.5); }
        .badge-pending { background-color: rgba(148,163,184,.12); color: #94a3b8; border-color: rgba(148,163,184,.25); }
        .badge-absent { background-color: rgba(100,116,139,.10); color: #64748b; font-style: italic; border-color: rgba(100,116,139,.2); }
        .glass-header { background: rgba(2,8,7,0.85); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(57,255,136,.18); box-shadow: 0 1px 24px rgba(57,255,136,.06); }
        .chart-wrapper { min-height: 260px; }

        /* --- Dark theme overrides for the light-theme Tailwind utility classes still used inline --- */
        .bg-white, .bg-slate-50, .bg-slate-100 { background-color: #060f0d !important; }
        .border-slate-100, .border-slate-200 { border-color: rgba(57,255,136,.18) !important; }
        .text-slate-400 { color: rgba(148,197,178,.55) !important; }
        .text-slate-500 { color: rgba(148,197,178,.75) !important; }
        .text-slate-600 { color: #a7f3d0 !important; }
        .text-slate-700, .text-slate-800, .text-slate-900 { color: #ecfdf5 !important; }
        .bg-blue-50, .bg-blue-50\/30, .bg-blue-50\/50 { background-color: rgba(34,211,238,.06) !important; }
        .bg-blue-100 { background-color: rgba(34,211,238,.14) !important; }
        .text-blue-600, .text-blue-700, .text-blue-800 { color: #22d3ee !important; }
        .border-blue-100, .border-blue-200, .border-blue-400 { border-color: rgba(34,211,238,.35) !important; }
        .hover\:bg-blue-50:hover { background-color: rgba(34,211,238,.12) !important; }
        .focus\:ring-blue-500:focus { --tw-ring-color: rgba(34,211,238,.5) !important; }
        .hover\:bg-slate-50:hover, .hover\:bg-slate-100:hover, .hover\:bg-slate-200:hover { background-color: rgba(57,255,136,.08) !important; }
        .bg-red-100 { background-color: rgba(248,113,113,.12) !important; }
        .border-red-200 { border-color: rgba(248,113,113,.35) !important; }
        .text-red-600, .text-red-700 { color: #fca5a5 !important; }
        .hover\:bg-red-200:hover { background-color: rgba(248,113,113,.2) !important; }
        table { color: #a7f3d0; }
        input, select { color: #ecfdf5; }
        input::placeholder { color: rgba(148,197,178,.5); }
        @media (max-width: 640px) {
            body { padding-bottom: 12px; }
            .chart-wrapper { min-height: 280px; }
            #analytics-section { scroll-margin-top: 72px; }
            table { font-size: .78rem; }
        }
        @media (min-width: 641px) {
            .chart-wrapper { min-height: 360px; }
        }
        .fixed .chart-wrapper { height: calc(100dvh - 115px) !important; min-height: 0; }
        @media (max-width: 640px) {
            .fixed { padding: 12px !important; }
            .fixed .chart-wrapper { height: calc(100dvh - 105px) !important; }
            .fixed .title-text { padding-right: 70px; line-height: 1.35; }
        }
    </style>
    <script src="who_data.js"></script>
</head>
<body class="text-slate-800 pb-20">

    <header class="glass-header sticky top-0 z-40 px-4 py-3 flex items-center justify-center">
        <div class="w-full max-w-7xl flex items-center justify-center">
            <div class="text-center">
                <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 mono">SMI <span class="bg-gradient-to-r from-cyan-400 to-emerald-400 bg-clip-text text-transparent">PRO</span></h1>
                <p class="text-[10px] sm:text-xs font-semibold text-emerald-400/70 tracking-[.18em] uppercase mono">&gt; who_growth_analysis<span class="animate-pulse">_</span></p>
            </div>
        </div>
    </header>

    <div class="max-w-7xl mx-auto p-4 md:p-6 space-y-6 mt-2">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="app-card p-5 rounded-2xl transition-all duration-300">
                <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4">1. සැකසුම්</h2>
                <div class="space-y-4">
                    <input type="password" id="api-key" placeholder="Enter Gemini Key" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none text-base">
                    <select id="gender" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none text-base font-medium">
                        <option value="boys">👦 පිරිමි ළමුන් (Boys)</option>
                        <option value="girls">👧 ගැහැණු ළමුන් (Girls)</option>
                    </select>
                    <select id="date-format" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none text-base font-medium">
                        <optgroup label="🌐 ISO 8601 (International Standard)">
                            <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                        </optgroup>
                        <optgroup label="📅 Day/Month/Year (UK, EU, Sri Lanka, most of world)">
                            <option value="DD.MM.YY" selected>DD.MM.YY</option>
                            <option value="DD.MM.YYYY">DD.MM.YYYY</option>
                            <option value="DD/MM/YY">DD/MM/YY</option>
                            <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                            <option value="DD-MM-YY">DD-MM-YY</option>
                            <option value="DD-MM-YYYY">DD-MM-YYYY</option>
                        </optgroup>
                        <optgroup label="📅 Month/Day/Year (US)">
                            <option value="MM.DD.YY">MM.DD.YY</option>
                            <option value="MM.DD.YYYY">MM.DD.YYYY</option>
                            <option value="MM/DD/YY">MM/DD/YY</option>
                            <option value="MM/DD/YYYY">MM/DD/YYYY</option>
                            <option value="MM-DD-YY">MM-DD-YY</option>
                            <option value="MM-DD-YYYY">MM-DD-YYYY</option>
                        </optgroup>
                        <optgroup label="📅 Year/Month/Day">
                            <option value="YY.MM.DD">YY.MM.DD</option>
                            <option value="YYYY.MM.DD">YYYY.MM.DD</option>
                            <option value="YY/MM/DD">YY/MM/DD</option>
                            <option value="YYYY/MM/DD">YYYY/MM/DD</option>
                            <option value="YY-MM-DD">YY-MM-DD</option>
                        </optgroup>
                        <optgroup label="📅 Year/Day/Month">
                            <option value="YY.DD.MM">YY.DD.MM</option>
                            <option value="YYYY.DD.MM">YYYY.DD.MM</option>
                            <option value="YY/DD/MM">YY/DD/MM</option>
                            <option value="YYYY/DD/MM">YYYY/DD/MM</option>
                            <option value="YY-DD-MM">YY-DD-MM</option>
                        </optgroup>
                    </select>
                    <div class="grid grid-cols-2 gap-3">
                        <select id="height-unit" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none text-base font-medium">
                            <option value="cm">📏 Height: cm</option>
                            <option value="ft">📏 Height: feet</option>
                        </select>
                        <select id="weight-unit" class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none text-base font-medium">
                            <option value="kg">⚖️ Weight: kg</option>
                            <option value="g">⚖️ Weight: g</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 block">Analysis Mode</label>
                        <div class="grid grid-cols-2 gap-2 p-1 bg-slate-50 border border-slate-200 rounded-xl">
                            <button type="button" id="mode-fast-btn" onclick="setAnalysisMode('fast')" class="py-2.5 rounded-lg text-sm font-bold transition-colors">⚡ Fast</button>
                            <button type="button" id="mode-accurate-btn" onclick="setAnalysisMode('accurate')" class="py-2.5 rounded-lg text-sm font-bold transition-colors">🎯 Accurate</button>
                        </div>
                        <p id="mode-desc" class="text-[11px] text-slate-400 mt-1.5"></p>
                    </div>
                </div>
            </div>

            <div class="app-card p-5 rounded-2xl transition-all duration-300">
                <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4">2. දත්ත ඇතුලත් කිරීම</h2>
                
                <!-- Updated Input: Removed capture="environment" and added application/pdf -->
                <label for="image-upload" class="scan-box flex flex-col items-center justify-center w-full min-h-32 border-2 border-dashed rounded-2xl cursor-pointer hover:scale-[1.01] transition-all duration-200">
                    <p class="text-base font-bold text-slate-700 text-center px-4">📸 Select Image or PDF<br><span class="text-xs font-normal text-slate-500">(Camera / Gallery / Files)</span></p>
                    <input id="image-upload" type="file" accept="image/*,application/pdf" class="hidden" onchange="handleFileUpload(event)" />
                </label>
                
                <div id="preview-container" class="hidden mt-3 text-center">
                    <img id="image-preview" class="max-h-32 mx-auto rounded-xl shadow-sm border border-slate-200 object-contain" src="" alt="Preview">
                </div>
                
                <button id="analyze-btn" onclick="processImageWithGemini()" class="primary-btn mt-4 w-full text-white font-bold py-3.5 rounded-2xl shadow-md transition-all text-base sm:text-lg">
                    Analyze Data ✨
                </button>

                <!-- New: Manual Data Entry Button -->
                <button onclick="toggleManualEntry()" class="mt-3 w-full bg-slate-100 text-slate-600 font-bold py-2.5 rounded-xl border border-slate-200 hover:bg-slate-200 transition-all text-sm">
                    ✍️ Enter Data Manually
                </button>

                <!-- New: Manual Entry Form -->
                <div id="manual-entry-form" class="hidden mt-4 bg-white border border-blue-100 p-4 rounded-xl shadow-inner space-y-3">
                    <h3 class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2">Manual Entry Form</h3>
                    <div class="flex gap-2">
                        <input type="text" id="man-serial" placeholder="No." class="w-1/3 p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-1 focus:ring-blue-500">
                        <input type="text" id="man-name" placeholder="Student Name" class="w-2/3 p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-1 focus:ring-blue-500">
                    </div>
                    <input type="date" id="man-dob" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-1 focus:ring-blue-500">
                    <div class="flex gap-2">
                        <input type="number" id="man-height" placeholder="Height (cm)" class="w-1/2 p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-1 focus:ring-blue-500">
                        <input type="number" id="man-weight" placeholder="Weight (kg)" class="w-1/2 p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-1 focus:ring-blue-500">
                    </div>
                    <p class="text-[11px] text-slate-400 -mt-1">Uses the Height/Weight units selected in section 1 above.</p>
                    <button onclick="addManualRecord()" class="w-full bg-emerald-500 text-white font-bold py-2.5 rounded-lg shadow hover:bg-emerald-600 transition-all text-sm">
                        ➕ Add to Table
                    </button>
                </div>

                <div id="loading" class="hidden mt-3 bg-blue-50 p-4 rounded-xl">
                    <div class="flex justify-between items-center mb-2">
                        <span id="progress-stage" class="text-blue-700 font-semibold text-sm">Preparing...</span>
                        <span id="progress-pct" class="text-blue-700 font-extrabold text-sm mono">0%</span>
                    </div>
                    <div class="w-full h-2.5 bg-blue-100 rounded-full overflow-hidden">
                        <div id="progress-bar" class="h-full rounded-full transition-all duration-300 ease-out" style="width: 0%; background: linear-gradient(90deg, #06b6d4, #39ff88); box-shadow: 0 0 10px rgba(57,255,136,.5);"></div>
                    </div>
                </div>
            </div>
        </div>

        <div id="analytics-section" class="hidden app-card p-4 sm:p-5 rounded-2xl">
            <div class="flex flex-col md:flex-row justify-between items-center mb-6">
                <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4 md:mb-0">3. ප්‍රස්ථාර (WHO Curves)</h2>
                <select id="student-filter" onchange="updateCharts()" class="w-full md:w-1/2 p-3 bg-blue-50 border border-blue-200 text-blue-800 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none font-bold">
                    <option value="ALL">📊 සියලුම ළමුන් (All Students)</option>
                </select>
            </div>

            <div id="chart-outlier-note" class="hidden mb-4 text-xs font-semibold text-amber-300 bg-amber-500/10 border border-amber-400/30 rounded-xl px-4 py-2.5"></div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                
                <div id="bmi-chart-container" class="border border-slate-100 p-4 rounded-xl bg-slate-50 relative transition-all duration-300 flex flex-col">
                    <button onclick="toggleFullScreen('bmi-chart-container', bmiChartInstance)" class="absolute top-2 right-2 bg-white border border-slate-200 p-2 rounded-lg shadow-sm hover:bg-blue-50 z-10 text-blue-600 font-bold text-xs flex items-center gap-1" id="bmi-btn-expand">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg> Fullscreen
                    </button>
                    <button onclick="toggleFullScreen('bmi-chart-container', bmiChartInstance)" class="hidden absolute top-4 right-4 bg-red-100 border border-red-200 p-3 rounded-lg shadow-md hover:bg-red-200 z-10 text-red-700 font-bold flex items-center gap-1" id="bmi-btn-close">
                        ✖ Close
                    </button>
                    <h4 class="text-center font-bold text-slate-700 mb-2 text-sm title-text">BMI-for-Age (WHO Standard)</h4>
                    <div class="relative w-full aspect-[4/3] md:aspect-auto flex-grow chart-wrapper">
                        <canvas id="whoBmiChart"></canvas>
                    </div>
                </div>

                <div id="hfa-chart-container" class="border border-slate-100 p-4 rounded-xl bg-slate-50 relative transition-all duration-300 flex flex-col">
                    <button onclick="toggleFullScreen('hfa-chart-container', hfaChartInstance)" class="absolute top-2 right-2 bg-white border border-slate-200 p-2 rounded-lg shadow-sm hover:bg-blue-50 z-10 text-blue-600 font-bold text-xs flex items-center gap-1" id="hfa-btn-expand">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg> Fullscreen
                    </button>
                    <button onclick="toggleFullScreen('hfa-chart-container', hfaChartInstance)" class="hidden absolute top-4 right-4 bg-red-100 border border-red-200 p-3 rounded-lg shadow-md hover:bg-red-200 z-10 text-red-700 font-bold flex items-center gap-1" id="hfa-btn-close">
                        ✖ Close
                    </button>
                    <h4 class="text-center font-bold text-slate-700 mb-2 text-sm title-text">Height-for-Age (Stunting)</h4>
                    <div class="relative w-full aspect-[4/3] md:aspect-auto flex-grow chart-wrapper">
                        <canvas id="whoHfaChart"></canvas>
                    </div>
                </div>

            </div>
        </div>

        <div class="app-card rounded-2xl overflow-hidden">
            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <div>
                    <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider">4. විශ්ලේෂිත දත්ත</h2>
                    <p class="text-[11px] text-emerald-400/70 mt-1">✏️ DOB, Height & Weight columns are editable - click a value to correct OCR mistakes, it recalculates instantly.</p>
                </div>
                <span id="record-count" class="bg-blue-100 text-blue-700 text-xs font-extrabold px-3 py-1 rounded-full">0</span>
            </div>
            <div class="overflow-x-auto pb-4">
                <table class="w-full text-sm text-left text-slate-600 min-w-[900px]">
                    <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-4 py-3 font-bold">No.</th>
                            <th class="px-4 py-3 font-bold">Name</th>
                            <th class="px-4 py-3 font-bold text-center">DOB / Age (Y.M)</th>
                            <th class="px-4 py-3 font-bold text-center">Height</th>
                            <th class="px-4 py-3 font-bold text-center">Weight</th>
                            <th class="px-4 py-3 font-bold text-center">BMI</th>
                            <th class="px-4 py-3 font-bold text-center">HFA Status</th>
                            <th class="px-4 py-3 font-bold text-center">BMI Status</th>
                            <th class="px-4 py-3 font-bold text-center border-l border-slate-200 bg-blue-50/50">Target Height</th>
                            <th class="px-4 py-3 font-bold text-center bg-blue-50/50">Target Weight</th>
                            <th class="px-4 py-3 font-bold text-center bg-blue-50/50">Action</th>
                        </tr>
                    </thead>
                    <tbody id="data-table-body" class="divide-y divide-slate-100">
                        <tr><td colspan="11" class="px-6 py-12 text-center text-slate-400 font-medium">No data available yet.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        let compressedBase64 = "";
        let imageMimeType = "";
        let extractedGlobalData = [];
        let bmiChartInstance = null;
        let hfaChartInstance = null;
        let analysisMode = 'accurate'; // 'fast' or 'accurate' - toggled in Section 1

        function setAnalysisMode(mode) {
            analysisMode = mode;
            const fastBtn = document.getElementById('mode-fast-btn');
            const accBtn = document.getElementById('mode-accurate-btn');
            const desc = document.getElementById('mode-desc');
            const activeCls = "py-2.5 rounded-lg text-sm font-bold transition-colors bg-gradient-to-r from-cyan-400 to-emerald-400 text-black shadow";
            const inactiveCls = "py-2.5 rounded-lg text-sm font-bold transition-colors text-slate-400";
            if (mode === 'fast') {
                fastBtn.className = activeCls;
                accBtn.className = inactiveCls;
                desc.textContent = "⚡ Quicker results - good for clear, neat handwriting.";
            } else {
                accBtn.className = activeCls;
                fastBtn.className = inactiveCls;
                desc.textContent = "🎯 Slower, more careful reading - best for messy handwriting & accurate DOB.";
            }
        }
        setAnalysisMode('accurate');

        // Dark "hacker terminal" theme defaults for Chart.js (must run before any chart is created)
        if (typeof Chart !== 'undefined') {
            Chart.defaults.color = '#a7f3d0';
            Chart.defaults.borderColor = 'rgba(57,255,136,.12)';
            Chart.defaults.font.family = "'JetBrains Mono', monospace";
        }

